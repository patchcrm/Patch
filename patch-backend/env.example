# Copy this file to .env and fill in your own values.
# NEVER share your .env file, NEVER paste these values into a chat,
# and NEVER commit .env to git (add it to .gitignore).

DOMAIN_CLIENT_ID=your-client-id-here
DOMAIN_CLIENT_SECRET=your-client-secret-here

# "primary" for read APIs (Address Suggestions, Agents & Listings,
# Properties & Locations). "sandbox" for Listings Management write
# testing. See README.md for why these differ.
DOMAIN_ENV=primary

# Space-separated list of scopes. Check your Domain portal's
# "create client" screen for the exact scope names available to
# your project — this is a starting guess, not a guarantee.
DOMAIN_SCOPES=api_addresslocators_read

PORT=3001
